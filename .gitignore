src/obj/
src/*.elf
src/*.elf.stripped
src/*.z64
src/*.bin
src/*.sym
src/*.msym
src/*.dfs
src/filesystem/*.WAD
src/filesystem/identifier
src/filesystem/mus/
src/filesystem/soundfont.sf64
build/

# --- copyrighted game data: never commit ---
# Bring your own IWAD(s); see input/README.md.
input/*
!input/README.md

# --- build output ---
output/*
!output/README.md

# --- pre-rendered music WAVs (host-side step, see tools/render_music.py) ---
music_wav/

# --- third-party SoundFonts: only the one render_music.py actually uses by
# default is worth the repo weight; the rest are unused leftovers from the
# old live-synth era (see tools/soundfont/README.md) ---
tools/soundfont/*.sf2
tools/soundfont/*.SF2
!tools/soundfont/SC-55 Deemster \[GZDoom\].sf2

# --- python cache ---
__pycache__/
*.pyc

# --- libdragon CLI local cache (keep the project marker) ---
.libdragon/*
!.libdragon/config.json

# --- vendored host build tools / prebuilt engine (see tools/vendor/*/README.md -
# built locally via tools/vendor/bin/build-tools.sh + `make engine`, or
# fetched from a GitHub Release; never committed) ---
tools/vendor/bin/*
!tools/vendor/bin/*.sh
!tools/vendor/bin/README.md
tools/vendor/engine/*.elf
tools/vendor/engine/*.elf.stripped
tools/vendor/engine/*.sym
tools/vendor/engine/*.msym
!tools/vendor/engine/README.md
